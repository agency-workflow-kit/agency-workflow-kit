{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio://schemas/critic-verdict.schema.json",
  "title": "Studio Critic Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_id", "reviewed_revision", "verdict", "acceptance_results", "evidence"],
  "properties": {
    "work_id": {"type": "string", "minLength": 1},
    "reviewed_revision": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["PASS", "FAIL", "BLOCKED_INCONCLUSIVE"]},
    "acceptance_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "result"],
        "properties": {
          "criterion": {"type": "string"},
          "result": {"enum": ["pass", "fail", "inconclusive"]},
          "evidence": {"type": "array", "items": {"type": "string"}, "default": []}
        }
      }
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "blocking_findings": {"type": "array", "items": {"type": "string"}, "default": []},
    "runtime_verified": {"type": "boolean", "default": false}
  }
}
