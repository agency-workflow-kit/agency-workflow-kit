{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio://schemas/work-order.schema.json",
  "title": "Studio Work Order",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_id", "objective", "scope", "non_goals", "acceptance_criteria", "executor", "owned_paths", "permitted_side_effects", "evidence_required"],
  "properties": {
    "work_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "executor": {"enum": ["agency-researcher", "agency-coder", "agency-resolver", "agency-critic"]},
    "owned_paths": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}, "default": []},
    "permitted_side_effects": {"type": "array", "items": {"type": "string"}},
    "operator_gate_required": {"type": "boolean", "default": false},
    "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
